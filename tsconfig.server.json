{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "verbatimModuleSyntax": false,
    "types": ["node"],
    "paths": {
      "@server/*": ["./server/*"],
      "@shared/*": ["./shared/*"],
      "@db/*": ["./db/*"]
    }
  },
  "include": ["server/**/*.ts", "shared/**/*.ts", "db/**/*.ts", "api/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
